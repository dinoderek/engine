{
  "name": "engine",
  "version": "0.11.0",
  "description": "Two skills, with a merge guard: build takes one task to a merged PR in any repo; engine holds the server roles, planner, executor and supervisor.",
  "author": {
    "name": "dinoderek"
  },
  "skills": "./skills/",
  "hooks": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "engine hook pre-tool-use"
            }
          ]
        }
      ],
      "PermissionRequest": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "engine hook permission"
            },
            {
              "type": "command",
              "command": "engine hook state"
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "engine hook state"
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "engine hook state"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "engine hook state"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "engine hook state"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "engine hook state"
            }
          ]
        }
      ],
      "Interrupt": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "engine hook state"
            }
          ]
        }
      ]
    }
  }
}
