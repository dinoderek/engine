{
  "description": "engine's merge guard: blocks gh pr merge without --match-head-commit, auto-merge, --admin, and merges through the API; in server sessions, blocks every PR merge. In unattended sessions, denies and logs permission requests. In engine sessions, records whether the last turn has ended.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "engine hook pre-tool-use"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "engine hook state"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "engine hook permission"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "engine hook permission"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit|billing_error",
        "hooks": [
          {
            "type": "command",
            "command": "engine hook limit"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "quota_auto_resume_fired|quota_auto_resume_stale|quota_auto_resume_disabled",
        "hooks": [
          {
            "type": "command",
            "command": "engine hook limit"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "engine hook limit"
          },
          {
            "type": "command",
            "command": "engine hook state"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "engine hook state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "engine hook state"
          }
        ]
      }
    ]
  }
}
