{
  "description": "engine's merge guard: blocks gh pr merge without --match-head-commit, auto-merge, --admin, and merges through the API. In unattended sessions, denies and logs permission requests.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "engine hook pre-tool-use" }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "command": "engine hook permission" }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          { "type": "command", "command": "engine hook permission" }
        ]
      }
    ]
  }
}
